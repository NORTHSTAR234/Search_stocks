  "macro": {
    "m_GUID": -987800001,
    "m_name": "DroidMacro Bulk Installer — 19 stocks (Centred Save 90,88)",
    "m_category": "Uncategorized",
    "m_description": "Installs 19 first-table stock macros. Global DroidMacro_LinkWait_Seconds = 4 initially, used by all open-link waits; never reset. Centered Save taps at 90%,88%. Progress reset to 1 on each new run, 500ms after counter update, no screen-name checks.",
    "m_completed": true,
    "m_enabled": true,
    "m_triggerList": [
