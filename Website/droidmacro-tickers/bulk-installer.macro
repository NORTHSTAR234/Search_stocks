  "macro": {
    "m_GUID": 0,
    "m_name": "DroidMacro Bulk Installer — 18 first-table stocks",
    "m_category": "Uncategorized",
    "m_description": "Opens 18 current MacroDroid links, checks expected macro name in UI, clicks white bottom-right Add/Save at 87% x / 86% y, and resumes from the last attempted number using global DroidMacro_BulkNext. Manual calibration may be required; do not run twice without reviewing.",
    "m_completed": true,
    "m_enabled": true,
    "m_triggerList": [
      {
        "m_classType": "ShortcutTrigger",
        "m_SIGUID": 0
      }
    ],
