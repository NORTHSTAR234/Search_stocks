    "m_name": "DroidMacro Bulk Installer — 20 stocks (Direct Save)",
    "m_category": "Uncategorized",
    "m_description": "No text checks; for each ticker open link, wait 3 seconds, wait 500ms, click Save at (87%,86%) using phone-tested full UIInteractionAction, then advance progress. Blind-click risk if link loads late.",
    "m_completed": true,
    "m_enabled": true,
