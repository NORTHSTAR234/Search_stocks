  "macro": {
    "m_GUID": -989800024,
    "m_name": "DroidMacro Bulk Installer — 24 stocks (Centred Save 90,88)",
    "m_category": "Uncategorized",
    "m_description": "Installs 24 first-table stock macros, each with full Search_stock workflow instruction, My_order=Count, total=24. On every manual launch resets bulk order to 1 but NEVER resets global editable DroidMacro_LinkWait_Seconds (starts at 4s). Each stock: Open link → variable wait seconds → Save tap center (90%,88%) → advance progress → wait 500ms. No screen text check.",
    "m_completed": true,
    "m_enabled": true,
    "m_triggerList": [
      {
        "m_classType": "ShortcutTrigger",
        "m_SIGUID": -989920000
      }
    ],
